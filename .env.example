# Required — powers the "Ask My AI" chat widget (get key at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Server port
PORT=3000

# Optional — contact form email delivery via Resend (https://resend.com).
# If RESEND_API_KEY is omitted, the contact form gracefully falls back to a mailto link.
RESEND_API_KEY=
CONTACT_TO=adari.tarun@gmail.com
# Must be a verified Resend sender. Use onboarding@resend.dev for quick testing.
CONTACT_FROM=Portfolio <onboarding@resend.dev>
